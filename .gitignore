node_modules
.DS_Store

# Per-video renders, QA stills and intermediates (regenerable)
videos/*/out/
videos/*/work/

# Third-party reference material: never commit
videos/*/ref/

# Heavy media: regenerate with the pipeline (see README)
videos/*/public/*.mp4
videos/*/public/*.wav
!videos/*/public/pop.wav
!videos/*/public/whoosh.wav
!videos/*/public/key.wav
*.mov
*.m4a

# Private or third-party images used on screen (DMs, thumbnails, screenshots)
videos/*/public/*.png
videos/*/public/*.jpg
!videos/*/public/remotion.png

# Published deliverables live outside git
finals/

# Third-party illustrations used on screen
videos/*/public/*.svg

# Local tool caches (absolute paths, per machine)
.atl/

# Clips of past reels or recorded boards used as inserts (regenerable from finals/)
videos/*/public/clips/
